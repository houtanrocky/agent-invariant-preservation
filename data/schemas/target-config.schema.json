{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "origin_url": {
      "const": "https://github.com/houtanrocky/dragon-market"
    },
    "baseline_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "pin_status": {
      "type": "string",
      "minLength": 1
    },
    "documentation_observed_on": {
      "type": "string",
      "format": "date"
    },
    "documentation_source": {
      "type": "string",
      "format": "uri"
    },
    "checkout_directory": {
      "const": ".local/dragon-market"
    },
    "go_requirement": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "origin_url",
    "baseline_commit",
    "pin_status",
    "documentation_observed_on",
    "documentation_source",
    "checkout_directory",
    "go_requirement",
    "database"
  ],
  "additionalProperties": false
}
