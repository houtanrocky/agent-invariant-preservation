{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "agents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "const": "command_stdin"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "agent_version": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "token_budget": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "cost_budget_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "budget_enforcement": {
            "type": "string",
            "minLength": 1
          },
          "environment_variable_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "integration_status": {
            "enum": [
              "unverified",
              "verified"
            ]
          }
        },
        "required": [
          "id",
          "adapter",
          "command",
          "model_id",
          "model_version",
          "agent_version",
          "timeout_seconds",
          "token_budget",
          "cost_budget_usd",
          "budget_enforcement",
          "environment_variable_names",
          "integration_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "agents"
  ],
  "additionalProperties": false
}
